<view class="page actions-page">
  <view class="eyebrow">个人现金流系统 · 优化对策</view>
  <view class="title">基于你的 DCF 结构，3 项改善建议</view>
  <view class="body intro">不急于盲目翻盘。通过防御缓冲、进攻造血与后半场兜底，筑牢你的现金流确定性。</view>

  <view class="action-list">
    <view wx:for="{{actions}}" wx:key="id" class="action-card">
      <view class="action-card-header">
        <text class="pillar-tag">{{item.pillarTag}}</text>
        <text class="period-pill">{{item.period}}</text>
      </view>
      <text class="action-title">{{item.title}}</text>
      <text class="rationale">{{item.rationale}}</text>
      <view class="first-step">
        <text class="first-step-tag">第一步</text>
        <text class="first-step-text">{{item.firstStep}}</text>
      </view>
      <view class="card-footer">
        <button class="save-button {{savedId === item.id ? 'saved' : ''}}" data-action="{{item}}" bindtap="save">
          {{savedId === item.id ? '✓ 已保存为备忘' : '📌 保存此项备忘'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 进阶工作台承接卡片 -->
  <view class="workbench-entry-card" bindtap="goToWorkbench">
    <view class="entry-title">🛠️ 前往 DCF 进阶工作台</view>
    <view class="entry-desc">想把上述对策转化为精细的多收入流底表、r × g 敏感性矩阵与目标反向求解？进入进阶工作台完整推演。</view>
    <button class="primary-button entry-btn">进入进阶工作台 →</button>
  </view>

  <button class="secondary-button back-btn" bindtap="backToResult">回到我的结构图</button>
  <view class="notice">行动建议仅供自我规划参考，不构成职业、投资或财务建议。</view>
</view>
