.actions-page .intro { margin-top:25rpx; }.action-list { margin:38rpx 0; }.action-card { margin-bottom:24rpx; padding:30rpx; border-radius:24rpx; background:#fff; box-shadow:0 8rpx 30rpx rgba(30,69,57,.06); }.period { color:#5b766d; font-size:23rpx; }.action-title { display:block; margin-top:12rpx; font-size:36rpx; font-weight:700; }.rationale { display:block; margin-top:14rpx; color:#5b6861; font-size:26rpx; line-height:1.55; }.first-step { display:flex; gap:16rpx; margin-top:25rpx; padding:20rpx; border-radius:14rpx; background:#edf3ee; color:#29443d; font-size:25rpx; line-height:1.5; }.first-step text:first-child { flex:0 0 auto; color:#1d5d50; font-weight:600; }.save-button { margin:22rpx 0 0; padding:0; background:transparent; color:#1d5d50; font-size:26rpx; line-height:1.4; text-align:left; }.save-button.saved { color:#5c756b; }.actions-page .notice { margin-top:28rpx; text-align:center; }
