.actions-page .eyebrow {
  font-size: 24rpx;
  color: #5b766d;
  letter-spacing: 2rpx;
}

.actions-page .title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #12332a;
  line-height: 1.28;
}

.title-line {
  display: block;
}

.actions-page .intro {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #557266;
  line-height: 1.55;
}

.action-list {
  margin: 24rpx 0 20rpx;
}

.action-card {
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1.5rpx solid #dce8e1;
  box-shadow: 0 4rpx 14rpx rgba(23, 63, 54, 0.04);
}

.action-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.pillar-tag {
  font-size: 23rpx;
  font-weight: 700;
  color: #0f766e;
  background: #ccfbf1;
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
}

.period-pill {
  color: #5c7b6d;
  font-size: 22rpx;
  background: #f1f6f3;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.action-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #173f36;
  line-height: 1.36;
}

.action-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #587569;
  line-height: 1.52;
}

/* 进阶工作台承接微卡片（组合3 · 现实校验与路径求解 · 居中对齐，与结果页完全对齐） */
.wb-teaser-card {
  position: relative;
  margin: 24rpx 0 20rpx;
  padding: 26rpx 50rpx;
  background: linear-gradient(135deg, #f0f7f3 0%, #eaf4ee 100%);
  border: 1.5rpx solid #c4dfd2;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(23, 63, 54, 0.04);
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.wb-teaser-card:active {
  transform: scale(0.99);
  background: #e4efe8;
}

.wb-teaser-center-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.wb-teaser-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.wb-teaser-icon {
  font-size: 28rpx;
  line-height: 1;
}

.wb-teaser-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #173f36;
  line-height: 1.35;
}

.wb-teaser-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #55776a;
  line-height: 1.4;
}

.wb-teaser-side-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  font-weight: 500;
  color: #4a7465;
  line-height: 1;
  transition: transform 0.2s ease;
}

.wb-teaser-card:active .wb-teaser-side-arrow {
  transform: translateY(-50%) translateX(4rpx);
}

.back-btn {
  margin-top: 8rpx !important;
}

.actions-page .notice {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #839d91;
}
