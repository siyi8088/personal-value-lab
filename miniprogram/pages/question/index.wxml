<view class="page question-page">
  <!-- Progress Header -->
  <view class="progress-row">
    <text>问题 {{step + 1}} / {{totalSteps}}</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{((step + 1) / totalSteps) * 100}}%"></view>
    </view>
  </view>

  <!-- STEP 0: 时间坐标与退休节点 -->
  <view wx:if="{{step === 0}}" class="step-container">
    <view class="question-title">你在哪个人生阶段？预计工作到几岁？</view>
    <view class="question-hint">系统将依据 2025 渐进式延迟退休新政，自动为你测算法定退休节点。</view>

    <!-- 性别选择 -->
    <view class="field-label"><text class="field-num">01</text>性别与基准</view>
    <view class="gender-row">
      <view class="gender-chip {{gender === 'male' ? 'active' : ''}}" data-value="male" bindtap="chooseGender">
        <text>男职工 / 干部</text>
      </view>
      <view class="gender-chip {{gender === 'female' ? 'active' : ''}}" data-value="female" bindtap="chooseGender">
        <text>女职工 / 干部</text>
      </view>
    </view>

    <!-- 年龄段 -->
    <view class="field-label"><text class="field-num">02</text>当前年龄阶段</view>
    <view class="grid-options">
      <view wx:for="{{ageBands}}" wx:key="id" class="grid-item {{ageBand === item.id ? 'active' : ''}}" data-value="{{item.id}}" bindtap="chooseAgeBand">
        <text>{{item.label}}</text>
      </view>
    </view>

    <!-- 政策测算结果卡片 -->
    <view class="policy-card">
      <view class="policy-badge">2025 延迟退休新政测算</view>
      <view class="policy-result">
        你的法定退休年龄约为：<text class="highlight">{{statutoryText}}</text>
      </view>
      <view class="policy-sub">确定了你劳动现金流的自然截止点（显性预测期）。</view>
    </view>

    <!-- 退休计划微调 -->
    <view class="field-label"><text class="field-num">03</text>你的主要工作预期</view>
    <view class="retirement-group">
      <view class="retirement-item {{retirementPlan === 'statutory' ? 'active' : ''}}" data-value="statutory" bindtap="chooseRetirementPlan">
        <view class="retirement-title">依法定退休</view>
        <view class="retirement-sub">（{{statutoryAge}} 岁）</view>
      </view>
      <view class="retirement-item {{retirementPlan === 'fire' ? 'active' : ''}}" data-value="fire" bindtap="chooseRetirementPlan">
        <view class="retirement-title">提前退休 / FIRE</view>
        <view class="retirement-sub">（50 岁）</view>
      </view>
      <view class="retirement-item {{retirementPlan === 'extended' ? 'active' : ''}}" data-value="extended" bindtap="chooseRetirementPlan">
        <view class="retirement-title">退而不休</view>
        <view class="retirement-sub">（{{statutoryAge + 5}} 岁）</view>
      </view>
    </view>
  </view>

  <!-- STEP 1: 工作期基准收入与类型 -->
  <view wx:if="{{step === 1}}" class="step-container">
    <view class="question-title">目前到手收入与工作类型？</view>
    <view class="question-hint">选择大概范围即可；这是确定你显性工作期现金流（PFCF）的基准。</view>

    <view class="field-label"><text class="field-num">01</text>工作状态与风险偏好</view>
    <view class="pill-group wrap">
      <view wx:for="{{workTypes}}" wx:key="id" class="pill-item {{workType === item.id ? 'active' : ''}}" data-value="{{item.id}}" bindtap="chooseWorkType">
        {{item.label}}
      </view>
    </view>

    <view class="field-label"><text class="field-num">02</text>每月到手收入区间</view>
    <view class="income-grid">
      <view wx:for="{{incomeOptions}}" wx:key="*this" class="income-grid-item {{incomeBand === item[0] ? 'selected' : ''}}" data-value="{{item[0]}}" bindtap="chooseIncome">
        <text class="income-grid-text">{{item[1]}}</text>
      </view>
    </view>

    <!-- 显性现金流基准测算卡片（对称问题1政策卡片，饱满填补空白） -->
    <view class="policy-card income-summary-card">
      <view class="policy-badge">PFCF 显性工作期基准测算</view>
      <view class="policy-result">
        预估年化净现金流：<text class="highlight">{{annualIncomeText}}</text>
      </view>
      <view class="policy-sub">确定了你折现公式中的自由现金流年化分子；{{workTypeDescText}}。</view>
    </view>
  </view>

  <!-- STEP 2: 短期调整与职业风险 (4类) -->
  <view wx:if="{{step === 2}}" class="step-container">
    <view class="question-title">未来 1–3 年的职业预期与风险？</view>
    <view class="question-hint">只有已确认的变化才计入前三年；中断风险将直观呈现 5 年收入断崖。</view>

    <view class="card-options">
      <view wx:for="{{riskOptions}}" wx:key="id" class="card-option {{careerRisk === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="chooseRisk">
        <view class="card-opt-header">
          <view class="card-opt-title-row">
            <text class="card-opt-title">{{item.title}}</text>
            <text wx:if="{{item.badge}}" class="card-badge">{{item.badge}}</text>
          </view>
          <text wx:if="{{careerRisk === item.id}}" class="check">✓</text>
        </view>
        <view class="card-opt-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- STEP 3: 退休后有限现金流 / 养老金 -->
  <view wx:if="{{step === 3}}" class="step-container">
    <view class="question-title">退休后预计的兜底保障？</view>
    <view class="question-hint">按今天购买力估算；属于退休后有限期年金现值，不计入永续终值。</view>

    <view class="card-options">
      <view wx:for="{{pensionOptions}}" wx:key="id" class="card-option {{pensionTier === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="choosePension">
        <view class="card-opt-header">
          <text class="card-opt-title">{{item.title}}</text>
          <text wx:if="{{pensionTier === item.id}}" class="check">✓</text>
        </view>
        <view class="card-opt-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- STEP 4: 独立持续收入引擎（终值准入检查） -->
  <view wx:if="{{step === 4}}" class="step-container">
    <view class="question-title">停止主要工作后，是否有持续收入引擎？</view>
    <view class="question-hint">关注个人持续造血底盘，不统计既有存量资产；仅指脱离日常打卡后，仍能独立运转产生的经营或物业净现金流。</view>

    <view class="field-label"><text class="field-num">01</text>持续造血引擎类型</view>
    <view class="card-options compact">
      <view wx:for="{{engineOptions}}" wx:key="id" class="card-option {{hasRecurringEngine === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="chooseEngine">
        <view class="card-opt-header">
          <text class="card-opt-title">{{item.title}}</text>
          <text wx:if="{{hasRecurringEngine === item.id}}" class="check">✓</text>
        </view>
        <view class="card-opt-desc">{{item.desc}}</view>
      </view>
    </view>

    <!-- 02 年净营运现金流：始终常驻显示，无引擎时置灰锁定为 0，避免页面空旷与高度跳动 -->
    <view class="engine-amount-box {{hasRecurringEngine === 'none' ? 'disabled' : ''}}">
      <view class="field-label engine-amount-label">
        <view class="label-left">
          <text class="field-num {{hasRecurringEngine === 'none' ? 'num-disabled' : ''}}">02</text>
          <text wx:if="{{hasRecurringEngine === 'none'}}">年净营运现金流</text>
          <text wx:else>年净营运现金流（扣除成本后）约为：</text>
        </view>
        <text wx:if="{{hasRecurringEngine === 'none'}}" class="locked-badge">已锁定 0 元</text>
      </view>
      <view class="engine-amount-grid">
        <view class="pill-item engine-amount-item {{hasRecurringEngine !== 'none' && engineAnnualNetCashFlow === 10000 ? 'active' : ''}}" data-value="10000" bindtap="chooseEngineAmount">约 1 万 / 年</view>
        <view class="pill-item engine-amount-item {{hasRecurringEngine !== 'none' && engineAnnualNetCashFlow === 30000 ? 'active' : ''}}" data-value="30000" bindtap="chooseEngineAmount">约 3 万 / 年</view>
        <view class="pill-item engine-amount-item {{hasRecurringEngine !== 'none' && engineAnnualNetCashFlow === 60000 ? 'active' : ''}}" data-value="60000" bindtap="chooseEngineAmount">约 6 万 / 年</view>
        <view class="pill-item engine-amount-item {{hasRecurringEngine !== 'none' && engineAnnualNetCashFlow === 120000 ? 'active' : ''}}" data-value="120000" bindtap="chooseEngineAmount">约 12 万 / 年</view>
        <view class="pill-item engine-amount-item {{hasRecurringEngine !== 'none' && engineAnnualNetCashFlow === 200000 ? 'active' : ''}}" data-value="200000" bindtap="chooseEngineAmount">20 万以上 / 年</view>
      </view>
    </view>
  </view>

  <!-- Bottom Navigation Buttons -->
  <view class="bottom-actions">
    <button class="secondary-button back" bindtap="previous">{{step === 0 ? '返回' : '上一题'}}</button>
    <button class="primary-button next" bindtap="next">{{step === totalSteps - 1 ? '生成我的 DCF 结构图' : '继续'}}</button>
  </view>

  <view class="notice">数据仅在本地运算，不上传服务器，绝不用于身价排名。</view>
</view>
