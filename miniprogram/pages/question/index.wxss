.step-container {
  margin-top: 10rpx;
}

.question-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #173f36;
  line-height: 1.4;
}

.question-hint {
  margin-top: 12rpx;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: #5c756b;
  line-height: 1.5;
}

.field-label {
  margin-top: 28rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2b4d42;
}

/* 性别选择 */
.gender-row {
  display: flex;
  gap: 18rpx;
}

.gender-chip {
  flex: 1;
  padding: 24rpx 16rpx;
  background: #f1f6f3;
  border: 2rpx solid #d4e3dc;
  border-radius: 18rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2c443c;
  font-weight: 500;
  transition: all 0.2s ease;
}

.gender-chip.active {
  background: #173f36;
  border-color: #173f36;
  color: #ffffff;
  font-weight: 600;
}

/* 网格选择（年龄等） */
.grid-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  padding: 22rpx 10rpx;
  background: #f1f6f3;
  border: 2rpx solid #d4e3dc;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2c443c;
}

.grid-item.active {
  background: #173f36;
  border-color: #173f36;
  color: #ffffff;
  font-weight: 600;
}

/* 政策测算卡片 */
.policy-card {
  margin: 28rpx 0 10rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #e6f2ec;
  border: 2rpx solid #b6dac7;
}

.policy-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #25705d;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.policy-result {
  font-size: 29rpx;
  color: #153e34;
  font-weight: 600;
}

.policy-result .highlight {
  font-size: 34rpx;
  color: #0d6b53;
  font-weight: 700;
}

.policy-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #55796c;
  line-height: 1.4;
}

/* 胶囊单选组 */
.pill-group {
  display: flex;
  gap: 14rpx;
}

.pill-group.wrap {
  flex-wrap: wrap;
}

.pill-item {
  padding: 16rpx 24rpx;
  background: #f3f7f4;
  border: 2rpx solid #d4e3dc;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #315146;
  transition: all 0.2s;
}

.pill-item.active {
  background: #286b5d;
  border-color: #286b5d;
  color: #ffffff;
  font-weight: 600;
}

/* 丰富卡片选项（Step 2, 3, 4） */
.card-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.card-option {
  padding: 26rpx;
  background: #ffffff;
  border: 2rpx solid #d9e6e0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(23, 63, 54, 0.04);
  transition: all 0.2s;
}

.card-option.selected {
  border-color: #173f36;
  background: #f4faf6;
}

.card-opt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-opt-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #173f36;
}

.card-badge {
  padding: 2rpx 12rpx;
  background: #e88d38;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.card-opt-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #617b71;
  line-height: 1.45;
}

.engine-amount-box {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f0f7f3;
  border-radius: 16rpx;
}

/* 列表单选（收入等） */
.list-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #f7faf8;
  border: 2rpx solid #d7e6df;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #243e35;
}

.option.selected {
  border-color: #173f36;
  background: #173f36;
  color: #ffffff;
  font-weight: 600;
}

.check {
  font-weight: 700;
  color: #1b8166;
}

.option.selected .check {
  color: #ffffff;
}

.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.bottom-actions button {
  margin: 0;
}

.bottom-actions .back {
  flex: 1;
}

.bottom-actions .next {
  flex: 2;
}

.notice {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #799288;
}
