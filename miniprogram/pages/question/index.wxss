.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.step-container {
  margin-top: 14rpx;
}

.question-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #173f36;
  line-height: 1.4;
}

.question-hint {
  margin-top: 12rpx;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: #5c756b;
  line-height: 1.5;
}

.field-label {
  margin-top: 44rpx;
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #1e453a;
  display: flex;
  align-items: center;
}

.field-num {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #1d5d50;
  background: #e2ede6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  letter-spacing: 1rpx;
}

/* 性别选择 */
.gender-row {
  display: flex;
  gap: 18rpx;
}

.gender-chip {
  flex: 1;
  padding: 24rpx 16rpx;
  background: #f1f6f3;
  border: 2rpx solid #d4e3dc;
  border-radius: 18rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2c443c;
  font-weight: 500;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.gender-chip.active {
  background: #e6f2eb;
  border: 2.5rpx solid #173f36;
  color: #173f36;
  font-weight: 700;
}

/* 网格选择（年龄等） */
.grid-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  padding: 22rpx 10rpx;
  background: #f1f6f3;
  border: 2rpx solid #d4e3dc;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2c443c;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.grid-item.active {
  background: #e6f2eb;
  border: 2.5rpx solid #173f36;
  color: #173f36;
  font-weight: 700;
}

/* 收入区间 3x3 紧凑网格 */
.income-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 10rpx;
}

.income-grid-item {
  padding: 24rpx 6rpx;
  background: #f1f6f3;
  border: 2rpx solid #d4e3dc;
  border-radius: 16rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.income-grid-item.selected {
  background: #e6f2eb;
  border: 2.5rpx solid #173f36;
}

.income-grid-text {
  font-size: 26rpx;
  color: #2c443c;
  font-weight: 500;
}

.income-grid-item.selected .income-grid-text {
  color: #173f36;
  font-weight: 700;
}

/* 政策测算卡片 */
.policy-card {
  margin: 28rpx 0 10rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #e6f2ec;
  border: 2rpx solid #b6dac7;
}

.policy-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #25705d;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.policy-result {
  font-size: 29rpx;
  color: #153e34;
  font-weight: 600;
}

.policy-result .highlight {
  font-size: 34rpx;
  color: #0d6b53;
  font-weight: 700;
}

.policy-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #55796c;
  line-height: 1.4;
}

/* 胶囊单选组 */
.pill-group {
  display: flex;
  gap: 14rpx;
}

.pill-group.wrap {
  flex-wrap: wrap;
}

.pill-item {
  padding: 18rpx 26rpx;
  background: #f3f7f4;
  border: 2rpx solid #d4e3dc;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #315146;
  box-sizing: border-box;
  transition: all 0.2s;
}

.pill-item.active {
  background: #e6f2eb;
  border: 2.5rpx solid #173f36;
  color: #173f36;
  font-weight: 700;
}

/* 退休计划微调（规整双行版式） */
.retirement-group {
  display: flex;
  gap: 14rpx;
}

.retirement-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 8rpx;
  background: #f1f6f3;
  border: 2rpx solid #d4e3dc;
  border-radius: 18rpx;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.retirement-item.active {
  background: #e6f2eb;
  border: 2.5rpx solid #173f36;
}

.retirement-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c443c;
  line-height: 1.3;
}

.retirement-item.active .retirement-title {
  color: #173f36;
  font-weight: 700;
}

.retirement-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #55796c;
}

.retirement-item.active .retirement-sub {
  color: #173f36;
  font-weight: 600;
}

/* 丰富卡片选项（Step 2, 3 舒展饱满版） */
.card-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.card-option {
  padding: 28rpx 26rpx;
  background: #ffffff;
  border: 2rpx solid #d9e6e0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(23, 63, 54, 0.04);
  box-sizing: border-box;
  transition: all 0.2s;
}

.card-option.selected {
  border: 2.5rpx solid #173f36;
  background: #eef6f1;
}

.card-opt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-opt-title-row {
  display: flex;
  align-items: center;
}

.card-opt-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #173f36;
}

.card-badge {
  padding: 4rpx 14rpx;
  background: #e88d38;
  color: #ffffff;
  font-size: 21rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.card-opt-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5c776c;
  line-height: 1.48;
}

/* 专供 Step 4 (问题 5) 的紧凑模式：确保展开金额二级框后仍完美单屏容纳无需滑动 */
.card-options.compact {
  gap: 12rpx;
  margin-bottom: 0;
}

.card-options.compact .card-option {
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 10rpx rgba(23, 63, 54, 0.03);
}

.card-options.compact .card-opt-title {
  font-size: 28rpx;
}

.card-options.compact .card-opt-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #617b71;
  line-height: 1.38;
}

.engine-amount-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #edf5f0;
  border-radius: 18rpx;
  border: 1.5rpx solid rgba(29, 93, 80, 0.12);
  transition: all 0.25s ease;
}

.engine-amount-box.disabled {
  background: #f1f5f2;
  border: 1.5rpx dashed #ccdcd3;
}

.num-disabled {
  background: #d8e3dc !important;
  color: #799388 !important;
}

.engine-amount-label {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  margin-top: 0 !important;
  margin-bottom: 14rpx !important;
}

.label-left {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e453a;
  white-space: nowrap;
}

.engine-amount-box.disabled .label-left {
  color: #769186;
}

.locked-badge {
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 20rpx;
  font-weight: 600;
  color: #5c7e71;
  background: #dfe8e2;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  letter-spacing: 0.5rpx;
}

.engine-amount-box.disabled .pill-item {
  background: #e8eee9;
  border-color: #d2ded7;
  color: #8fa69c;
  pointer-events: none;
  opacity: 0.88;
}

.engine-amount-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.engine-amount-item {
  flex: 1 1 calc(33.333% - 12rpx);
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 列表单选（收入等） */
.list-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #f7faf8;
  border: 2rpx solid #d7e6df;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #243e35;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.option.selected {
  border: 2.5rpx solid #173f36;
  background: #e6f2eb;
  color: #173f36;
  font-weight: 700;
}

.check {
  font-weight: 700;
  color: #1b8166;
}

.option.selected .check {
  color: #173f36;
}

.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.bottom-actions button {
  margin: 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
}

.bottom-actions .back {
  flex: 1;
  background: #e8f1ec;
  color: #225a4d;
  font-weight: 500;
  border: 1.5rpx solid rgba(29, 93, 80, 0.12);
}

.bottom-actions .back:active {
  background: #dfece4;
}

.bottom-actions .next {
  flex: 1;
  background: linear-gradient(135deg, #2d6f5f, #1f5749);
  box-shadow: 0 4rpx 14rpx rgba(31, 87, 73, 0.16);
  color: #ffffff;
  font-weight: 600;
}

.bottom-actions .next:active {
  opacity: 0.92;
}

.notice {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #799288;
}
