.question-page { display:flex; flex-direction:column; }.progress-row { color:#557269; font-size:25rpx; }.progress-track { height:10rpx; margin-top:16rpx; border-radius:999rpx; background:#dce6df; overflow:hidden; }.progress-fill { height:100%; border-radius:999rpx; background:#1d5d50; transition:width .2s; }.question-title { margin-top:72rpx; font-size:47rpx; line-height:1.3; font-weight:700; }.question-hint { margin-top:18rpx; color:#61756d; font-size:27rpx; line-height:1.6; }.options { margin-top:52rpx; }.option { min-height:104rpx; box-sizing:border-box; display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; padding:0 30rpx; border:2rpx solid #d6e1da; border-radius:18rpx; background:#fff; color:#29443d; font-size:30rpx; }.option.selected { border-color:#1d5d50; background:#e4f0e8; color:#154d42; font-weight:600; }.check { font-size:32rpx; }.bottom-actions { display:flex; gap:16rpx; margin-top:auto; padding-top:44rpx; }.back { flex:0.7; }.next { flex:1.3; }.disabled { opacity:.42; }.question-page .notice { margin-top:28rpx; text-align:center; }
