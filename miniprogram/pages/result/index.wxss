/* 顶部 Hero 总览卡片（现值大数 + 极简人设金句） */
.hero-overview-card {
  margin: 18rpx 0 24rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border: 2rpx solid #cce2d6;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 63, 54, 0.06);
  text-align: center;
}

.hero-val-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-caption {
  font-size: 24rpx;
  font-weight: 600;
  color: #5c7b6e;
  letter-spacing: 1rpx;
}

.hero-amount {
  margin: 10rpx 0 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #14493b;
  line-height: 1.15;
}

.hero-amount-undisclosed {
  margin: 10rpx 0 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #436357;
}

.hero-note {
  font-size: 22rpx;
  color: #7a988c;
  line-height: 1.4;
}

.hero-persona-divider {
  height: 1rpx;
  background: #eef4f0;
  margin: 22rpx 10rpx;
}

.hero-persona-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.hero-persona-badge {
  font-size: 30rpx;
  font-weight: 800;
  color: #173f36;
}

.hero-persona-punchline {
  font-size: 24rpx;
  font-weight: 500;
  color: #3b5f53;
  line-height: 1.45;
}

/* 结构堆叠图卡片 */
.structure-card {
  margin: 20rpx 0;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #d7e6df;
  box-shadow: 0 4rpx 16rpx rgba(23, 63, 54, 0.05);
}

.card-caption {
  font-size: 24rpx;
  font-weight: 600;
  color: #6a8277;
  margin-bottom: 20rpx;
}

.stacked-bar {
  display: flex;
  height: 28rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #e2ece7;
  margin-bottom: 28rpx;
}

.bar-seg {
  height: 100%;
  transition: width 0.3s ease;
}

.bar-seg.working {
  background: #256a59;
}

.bar-seg.pension {
  background: #5db39d;
}

.bar-seg.tv {
  background: #e59740;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #eef4f0;
}

.breakdown-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.working-dot { background: #256a59; }
.pension-dot { background: #5db39d; }
.tv-dot { background: #e59740; }

.item-name {
  color: #28443b;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-ratio {
  font-weight: 700;
  color: #173f36;
}

.item-amount {
  font-size: 22rpx;
  color: #708a7e;
}

/* 收入断崖预警 */
.cliff-alert {
  margin: 24rpx 0;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #fff8eb;
  border: 2rpx solid #f6cf8a;
}

.alert-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.alert-icon {
  font-size: 28rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #925c0e;
}

.alert-content {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #795213;
  line-height: 1.5;
}

.alert-content .bold {
  font-weight: 700;
  color: #c2410c;
}

.alert-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8c6422;
  line-height: 1.4;
}

.links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin: 28rpx 0;
  color: #1d5d50;
  font-size: 26rpx;
  text-decoration: underline;
}

/* 目标倒推迷你试玩卡片 (Hook) */
.reverse-hook-card {
  margin: 28rpx 0 16rpx;
  padding: 26rpx 28rpx;
  background: #f0f7f3;
  border: 2rpx solid #c8e0d4;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.hook-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hook-header-left {
  display: flex;
  flex-direction: column;
}

.hook-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #173f36;
}

.hook-subtitle {
  font-size: 22rpx;
  color: #557367;
  margin-top: 6rpx;
}

.hook-arrow {
  font-size: 24rpx;
  color: #1b8166;
  font-weight: 700;
  transition: transform 0.25s ease;
  display: inline-block;
}

.hook-arrow.arrow-up {
  transform: rotate(180deg);
}

.hook-expanded-body {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #dce8e0;
}

.hook-desc {
  font-size: 24rpx;
  color: #557367;
  line-height: 1.45;
}

.hook-slider-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.hook-target-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #173f36;
}

.hook-gap-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #ea580c;
}

.hook-result-preview {
  margin: 16rpx 0 20rpx;
  padding: 18rpx;
  background: #ffffff;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #245647;
  line-height: 1.5;
}

.hook-btn {
  margin-top: 10rpx !important;
  font-size: 28rpx !important;
  padding: 22rpx 0 !important;
}

.result-notice {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #839d91;
}
