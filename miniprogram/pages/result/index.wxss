.result-heading { margin-top:16rpx; font-size:54rpx; font-weight:700; }.summary { margin-top:15rpx; }.income-card,.qualitative-card { margin:44rpx 0 24rpx; padding:32rpx; border-radius:28rpx; background:#173f36; color:#fff; }.income-caption { color:#c7ddd3; font-size:24rpx; }.scenario { display:flex; justify-content:space-between; padding:23rpx 0; border-bottom:1rpx solid rgba(255,255,255,.18); color:#dceae3; font-size:27rpx; }.scenario text:last-child { font-size:31rpx; font-weight:600; color:#fff; }.scenario.base { margin:0 -12rpx; padding:23rpx 12rpx; border-radius:12rpx; background:#286b5d; }.scenario.unavailable text:last-child { color:#c8e3d7; font-size:27rpx; font-weight:400; }.income-note { margin-top:22rpx; color:#b7cec4; font-size:22rpx; line-height:1.55; }.qualitative-title { margin:16rpx 0; font-size:34rpx; font-weight:600; }.action-preview { margin:28rpx 0; padding:28rpx; border-radius:22rpx; background:#e7efe8; display:flex; flex-direction:column; }.preview-label { color:#5b766d; font-size:23rpx; }.preview-title { margin-top:12rpx; font-size:33rpx; font-weight:700; }.preview-body { margin-top:12rpx; color:#52655f; font-size:26rpx; line-height:1.55; }.share { margin-top:16rpx; }.links { display:flex; justify-content:center; gap:42rpx; margin:30rpx 0; color:#1d5d50; font-size:26rpx; text-decoration:underline; }.upgrade { margin-top:20rpx; padding:28rpx; border:2rpx solid #c9d9ce; border-radius:20rpx; }.upgrade-title { display:block; font-size:28rpx; font-weight:600; }.upgrade-link { display:block; margin-top:14rpx; color:#1d5d50; font-size:26rpx; }.result-notice { margin-top:28rpx; text-align:center; }
