/* 顶部 Hero 总览卡片（现值大数 + 极简人设金句） */
.hero-overview-card {
  margin: 18rpx 0 24rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border: 2rpx solid #cce2d6;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 63, 54, 0.06);
  text-align: center;
}

.hero-val-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-caption {
  font-size: 24rpx;
  font-weight: 600;
  color: #5c7b6e;
  letter-spacing: 1rpx;
}

.hero-amount {
  margin: 10rpx 0 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #14493b;
  line-height: 1.15;
}

.hero-amount-undisclosed {
  margin: 10rpx 0 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #436357;
}

.hero-note {
  font-size: 22rpx;
  color: #7a988c;
  line-height: 1.4;
}

.hero-persona-divider {
  height: 1rpx;
  background: #eef4f0;
  margin: 22rpx 10rpx;
}

.hero-persona-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.hero-persona-badge {
  font-size: 30rpx;
  font-weight: 800;
  color: #173f36;
}

.hero-persona-punchline {
  font-size: 24rpx;
  font-weight: 500;
  color: #3b5f53;
  line-height: 1.45;
}

/* 结构堆叠图卡片 */
.structure-card {
  margin: 20rpx 0;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #d7e6df;
  box-shadow: 0 4rpx 16rpx rgba(23, 63, 54, 0.05);
}

.card-caption {
  font-size: 24rpx;
  font-weight: 600;
  color: #6a8277;
  margin-bottom: 20rpx;
}

.stacked-bar {
  display: flex;
  height: 28rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #e2ece7;
  margin-bottom: 28rpx;
}

.bar-seg {
  height: 100%;
  transition: width 0.3s ease;
}

.bar-seg.working {
  background: #256a59;
}

.bar-seg.pension {
  background: #5db39d;
}

.bar-seg.tv {
  background: #e59740;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #eef4f0;
}

.breakdown-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.working-dot { background: #256a59; }
.pension-dot { background: #5db39d; }
.tv-dot { background: #e59740; }

.item-name {
  color: #28443b;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-ratio {
  font-weight: 700;
  color: #173f36;
}

.item-amount {
  font-size: 22rpx;
  color: #708a7e;
}

/* 收入断崖预警 */
.cliff-alert {
  margin: 24rpx 0;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #fff8eb;
  border: 2rpx solid #f6cf8a;
}

.alert-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.alert-icon {
  font-size: 28rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #925c0e;
}

.alert-content {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #795213;
  line-height: 1.5;
}

.alert-content .bold {
  font-weight: 700;
  color: #c2410c;
}

.alert-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8c6422;
  line-height: 1.4;
}

.secondary-button {
  margin-top: 20rpx !important;
}

.links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin: 28rpx 0;
  color: #1d5d50;
  font-size: 26rpx;
  text-decoration: underline;
}

/* 方案 A：轻量级反向 DCF 进阶入口微卡片（居中优雅版） */
.reverse-teaser-card {
  position: relative;
  margin: 28rpx 0 16rpx;
  padding: 24rpx 50rpx;
  background: linear-gradient(135deg, #f0f7f3 0%, #eaf4ee 100%);
  border: 1.5rpx solid #c4dfd2;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(23, 63, 54, 0.04);
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.reverse-teaser-card:active {
  transform: scale(0.99);
  background: #e4efe8;
}

.teaser-center-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.teaser-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.teaser-icon {
  font-size: 26rpx;
  line-height: 1;
}

.teaser-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #173f36;
  line-height: 1.35;
}

.teaser-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #55776a;
  line-height: 1.4;
}

/* 位于卡片上下垂直正中、靠右的轻量指示箭头 */
.teaser-side-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  font-weight: 500;
  color: #4a7465;
  line-height: 1;
  transition: transform 0.2s ease;
}

.reverse-teaser-card:active .teaser-side-arrow {
  transform: translateY(-50%) translateX(4rpx);
}

.result-notice {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #839d91;
}

/* 方法论弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 36rpx;
}

.rules-modal-box {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.rules-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #173f36;
  text-align: center;
  margin-bottom: 24rpx;
}

.rules-modal-body {
  font-size: 24rpx;
  color: #3b5a4e;
  line-height: 1.6;
}

.rules-lead {
  font-weight: 600;
  color: #173f36;
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.rules-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: #4a685c;
  line-height: 1.55;
}

.rules-item .num {
  font-weight: 700;
  color: #173f36;
  flex-shrink: 0;
}

.rules-divider {
  height: 1rpx;
  background: #eef4f0;
  margin: 22rpx 0 18rpx;
}

.articles-lead {
  font-weight: 600;
  color: #173f36;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.article-link-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #f4f8f5;
  border: 1rpx solid #dce8e1;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s ease;
}

.article-link-row:active {
  background: #e6f1eb;
}

.article-link-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #1d5d50;
  line-height: 1.4;
}

.article-link-icon {
  font-size: 24rpx;
  color: #1d5d50;
  font-weight: 700;
  margin-left: 10rpx;
}

.rules-close-btn {
  margin-top: 28rpx;
  background: transparent;
  border: 2rpx solid #1d5d50;
  color: #1d5d50;
  font-size: 28rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  padding: 0;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.rules-close-btn:active {
  background: rgba(29, 93, 80, 0.08);
}
