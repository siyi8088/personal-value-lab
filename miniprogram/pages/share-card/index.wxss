.share-page .title { font-size:48rpx; }.share-card { position:relative; overflow:hidden; height:720rpx; margin:40rpx 0 30rpx; padding:48rpx; box-sizing:border-box; border-radius:34rpx; color:#fff; background:linear-gradient(145deg,#1b5146,#2b7969); }.card-brand { position:relative; z-index:1; font-size:25rpx; letter-spacing:2rpx; }.card-orbits view { position:absolute; border:2rpx solid rgba(228,246,229,.28); border-radius:50%; transform:rotate(-25deg); }.card-orbits view:nth-child(1) { width:600rpx;height:250rpx;top:105rpx;left:-90rpx; }.card-orbits view:nth-child(2) { width:650rpx;height:310rpx;top:242rpx;left:130rpx; }.card-orbits view:nth-child(3) { width:350rpx;height:170rpx;top:395rpx;left:-60rpx; }.card-label { position:absolute; left:48rpx; bottom:240rpx; color:#c8e3d7; font-size:26rpx; }.card-title { position:absolute; left:48rpx; bottom:160rpx; font-size:64rpx; font-weight:700; }.card-declaration { position:absolute; left:48rpx; bottom:102rpx; font-size:29rpx; }.card-footer { position:absolute; left:48rpx; bottom:45rpx; color:#c8e3d7; font-size:23rpx; }.hidden-canvas { position:fixed; left:-2000rpx; top:-2000rpx; width:750rpx; height:1200rpx; }.privacy-copy { margin-bottom:30rpx; }.tip { margin-top:18rpx; }.share-page .notice { margin-top:28rpx; text-align:center; }
