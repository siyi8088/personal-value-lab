.share-page .title {
  font-size: 46rpx;
  font-weight: 700;
  color: #173f36;
}

.share-card {
  position: relative;
  overflow: hidden;
  height: 820rpx;
  margin: 36rpx 0 28rpx;
  padding: 44rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  color: #ffffff;
  background: linear-gradient(150deg, #173f36 0%, #256a59 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 16rpx 40rpx rgba(23, 63, 54, 0.18);
}

.card-brand {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #d2ebe0;
}

.card-orbits view {
  position: absolute;
  border: 2rpx solid rgba(228, 246, 229, 0.22);
  border-radius: 50%;
  transform: rotate(-25deg);
}

.card-orbits view:nth-child(1) {
  width: 600rpx;
  height: 250rpx;
  top: 105rpx;
  left: -90rpx;
}

.card-orbits view:nth-child(2) {
  width: 650rpx;
  height: 310rpx;
  top: 242rpx;
  left: 130rpx;
}

.card-orbits view:nth-child(3) {
  width: 350rpx;
  height: 170rpx;
  top: 395rpx;
  left: -60rpx;
}

.card-content {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.card-badge-pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: #39826f;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.card-label {
  color: #c4e4d5;
  font-size: 25rpx;
}

.card-title {
  margin: 6rpx 0 10rpx;
  font-size: 80rpx;
  font-weight: 800;
  color: #52e3b6;
  line-height: 1;
}

.card-declaration {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a4cebd;
}

/* 底部二维码区域 */
.card-qr-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.qr-text-group {
  display: flex;
  flex-direction: column;
}

.qr-action-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #e5f5ed;
}

.qr-action-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a3c9b8;
}

.qr-box {
  width: 104rpx;
  height: 104rpx;
  padding: 6rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.qr-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.hidden-canvas {
  position: fixed;
  left: -3000rpx;
  top: -3000rpx;
  width: 750rpx;
  height: 1200rpx;
}

.privacy-copy {
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: #668276;
}

.tip {
  margin-top: 18rpx;
}

.share-page .notice {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8ca398;
}
