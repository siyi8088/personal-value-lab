.landing {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 40rpx 48rpx;
}
.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 38rpx;
}
.settings {
  color: #567168;
  font-size: 24rpx;
}

/* 1. 核心文案置顶 */
.hero-header {
  margin-bottom: 24rpx;
}
.hero-title {
  display: flex;
  flex-direction: column;
}
.title-subline {
  font-size: 34rpx;
  font-weight: 600;
  color: #24584a;
  line-height: 1.32;
  letter-spacing: 0.5rpx;
}
.title-mainline {
  font-size: 54rpx;
  font-weight: 800;
  color: #12332a;
  line-height: 1.22;
  margin-top: 10rpx;
  letter-spacing: -1.5rpx;
}
.hero-intro {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.68;
  color: #4b635b;
}
.intro-sub {
  margin-top: 8rpx;
}

/* 2. 中部核心模型卡片（复原初版统一优雅的 -23deg 轨道弧线） */
.model-card {
  height: 420rpx;
  margin: 10rpx 0 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #dcece1, #f4f0d8);
  border: 1rpx solid rgba(29, 93, 80, 0.12);
  box-shadow: 0 10rpx 30rpx rgba(29, 93, 80, 0.05);
}
.model-card-label {
  position: absolute;
  left: 32rpx;
  top: 26rpx;
  font-size: 22rpx;
  color: #56776c;
  letter-spacing: 1rpx;
  font-weight: 500;
  z-index: 1;
}
.model-orbit {
  position: absolute;
  border: 2rpx solid rgba(29, 93, 80, 0.27);
  border-radius: 50%;
  transform: rotate(-23deg);
}
.orbit-one {
  width: 460rpx;
  height: 210rpx;
  top: 125rpx;
  left: -30rpx;
}
.orbit-two {
  width: 610rpx;
  height: 290rpx;
  top: 50rpx;
  left: 90rpx;
}
.orbit-three {
  width: 370rpx;
  height: 180rpx;
  top: 178rpx;
  left: 275rpx;
}

/* 三支柱标注胶囊（精准锚定在三条优雅轨道的焦点上） */
.pillar-tag {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  padding: 10rpx 20rpx 10rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(29, 93, 80, 0.14);
  box-shadow: 0 6rpx 16rpx rgba(29, 93, 80, 0.08);
  z-index: 2;
}
.pillar-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-labor {
  background: #1d5d50;
  box-shadow: 0 0 0 6rpx rgba(29, 93, 80, 0.18);
}
.dot-pension {
  background: #e37950;
  box-shadow: 0 0 0 6rpx rgba(227, 121, 80, 0.2);
}
.dot-terminal {
  background: #586fa3;
  box-shadow: 0 0 0 6rpx rgba(88, 111, 163, 0.2);
}
.pillar-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #173f36;
  white-space: nowrap;
}
.pillar-labor {
  left: 110rpx;
  top: 206rpx;
}
.pillar-pension {
  left: 380rpx;
  top: 92rpx;
}
.pillar-terminal {
  left: 400rpx;
  top: 282rpx;
}

/* 3. 特性背书栏 */
.trust-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 36rpx;
  margin: 10rpx 0 24rpx;
}
.trust-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #516d63;
  font-weight: 500;
}
.trust-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #1d5d50;
  opacity: 0.55;
}

/* 4. 行动区 */
.action-section {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
}
.start {
  width: 100%;
}
.continue {
  margin-top: 18rpx;
  width: 100%;
}
.rule-link {
  margin: 22rpx auto 14rpx;
  color: #1d5d50;
  text-decoration: underline;
  font-size: 27rpx;
  text-align: center;
}
.footer {
  margin-top: auto;
  text-align: center;
  font-size: 22rpx;
  color: #7b8f87;
  line-height: 1.55;
  padding-top: 14rpx;
}

/* 方法论弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 36rpx;
}

.rules-modal-box {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.rules-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #173f36;
  text-align: center;
  margin-bottom: 24rpx;
}

.rules-modal-body {
  font-size: 24rpx;
  color: #3b5a4e;
  line-height: 1.6;
}

.rules-lead {
  font-weight: 600;
  color: #173f36;
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.rules-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: #4a685c;
  line-height: 1.55;
}

.rules-item .num {
  font-weight: 700;
  color: #173f36;
  flex-shrink: 0;
}

.rules-divider {
  height: 1rpx;
  background: #eef4f0;
  margin: 22rpx 0 18rpx;
}

.articles-lead {
  font-weight: 600;
  color: #173f36;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.article-link-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #f4f8f5;
  border: 1rpx solid #dce8e1;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s ease;
}

.article-link-row:active {
  background: #e6f1eb;
}

.article-link-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #1d5d50;
  line-height: 1.4;
}

.article-link-icon {
  font-size: 24rpx;
  color: #1d5d50;
  font-weight: 700;
  margin-left: 10rpx;
}

.rules-close-btn {
  margin-top: 28rpx;
  background: transparent;
  border: 2rpx solid #1d5d50;
  color: #1d5d50;
  font-size: 28rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  padding: 0;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.rules-close-btn:active {
  background: rgba(29, 93, 80, 0.08);
}
